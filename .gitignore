# ============================================================
#  Career Pilot AI — .gitignore
# ============================================================

# ----- 🔐 SECRET FILES (NEVER COMMIT THESE) -----
.env
.env.*
!.env.example          # Allow the example/template file

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.so
.eggs/

# ----- Virtual Environments -----
.venv/
venv/
env/
ENV/

# ----- Node / React Frontend -----
node_modules/
dist/
.next/
.nuxt/
out/
build/
*.local

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt

# ----- OS Files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- IDE / Editor -----
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ----- Testing -----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ----- Misc -----
*.bak
*.tmp
